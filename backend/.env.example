# Sparrow Media OS Backend Environment
DJANGO_SECRET_KEY=sparrow-dev-secret-key-change-in-production
DJANGO_DEBUG=True

# Database (Set USE_POSTGRES=true when docker-compose is up)
USE_POSTGRES=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sparrow_os
POSTGRES_USER=sparrow_admin
POSTGRES_PASSWORD=sparrow_secret_dev

# Gemini API Key (Enter your key here; fallback is active if empty)
GEMINI_API_KEY=
